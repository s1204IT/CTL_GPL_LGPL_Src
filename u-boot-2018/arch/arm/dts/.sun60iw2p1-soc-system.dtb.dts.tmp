     #address-cells = <1>;
     #size-cells = <0>;
     reg = <1>;
     tcon3_out_hdmi: endpoint@0 {
      reg = <0>;
      remote-endpoint = <&hdmi_in_tcon3>;
     };
    };
   };
  };

  tv1: tcon4@5731000 {
   compatible = "allwinner,tcon-tv";
   reg = <0x0 0x05731000 0x0 0x1000>;
   interrupts = <0 58 4>;
   clocks = <&clk_edp>, <&clk_tcon_tv1>;
   clock-names = "clk_tcon", "clk_bus_tcon";
   top = <&vo1>;
   status = "disabled";

   ports {
    #address-cells = <1>;
    #size-cells = <0>;
    tcon4_in: port@0 {
     reg = <0>;
     #address-cells = <1>;
     #size-cells = <0>;
     tcon4_in_disp0: endpoint@0 {
      reg = <0>;
      remote-endpoint = <&disp0_out_tcon4>;
     };
     tcon4_in_disp1: endpoint@1 {
      reg = <1>;
      remote-endpoint = <&disp1_out_tcon4>;
     };
    };
    tcon4_out: port@1 {
     #address-cells = <1>;
     #size-cells = <0>;
     reg = <1>;
     tcon4_out_edp: endpoint@0 {
      reg = <0>;
      remote-endpoint = <&edp_in_tcon4>;
     };
    };
   };
  };

  drm_edp: drm_edp@5720000 {
   compatible = "allwinner,drm-dp";
   reg = <0x0 0x05740000 0x0 0x1000>,
      <0x0 0x05760000 0x0 0x0020>;
   interrupts = <0 62 4>;
   clocks = <&clk_edp>;
   clock-names = "clk_edp";


   phys = <&aux_hpd 99>, <&combophy0 6>;
   phy-names = "aux-phy", "dp-phy";
   pclk_limit = <200000>;
   status = "disabled";
   ports {
    #address-cells = <1>;
    #size-cells = <0>;
    edp_in: port@0 {
     #address-cells = <1>;
     #size-cells = <0>;
     reg = <0>;
     edp_in_tcon4: endpoint@0 {
      reg = <0>;
      remote-endpoint = <&tcon4_out_edp>;
     };
    };
    edp_out: port@1 {
     #address-cells = <1>;
     #size-cells = <0>;
     reg = <1>;
    };
   };
  };

  hdmi: hdmi@5520000 {
   compatible = "allwinner,sunxi-hdmi";
   reg = <0x0 0x5520000 0x0 0x100000>;
   interrupts = <0 61 4>;
   clocks = <&clk_hdmi_tv>,
    <&clk_hdmi_gate>,
    <&clk_hdmi_sfr>,
    <&clk_hdmi_main_rst>,
    <&clk_hdmi_sub_rst>;
   clock-names = "clk_tcon_tv",
    "clk_hdmi",
    "clk_hdmi_24M",
    "rst_main",
    "rst_sub";

   assigned-clocks = <&clk_hdmi_gate>;
   assigned-clock-rates = <0>, <0>;


   status = "disabled";
   ports {
    #address-cells = <1>;
    #size-cells = <0>;
    hdmi_in: port@0 {
     #address-cells = <1>;
     #size-cells = <0>;
     reg = <0>;
     hdmi_in_tcon3: endpoint@0 {
      reg = <0>;
      remote-endpoint = <&tcon3_out_hdmi>;
     };
    };
   };
  };
 };

 sunxi_dram_para_select: sunxi_dram_para_select {
   compatible = "allwinner,sunxi-dram-para-select";
   select_mode = <0>;
   gpadc_channel = <1>;
   status = "disabled";
 };

 gic: interrupt-controller@3020000 {
  compatible = "arm,cortex-a15-gic", "arm,cortex-a9-gic";
  #interrupt-cells = <3>;
  #address-cells = <0>;
  device_type = "gic";
  interrupt-controller;
  reg = <0x0 0x03021000 0 0x1000>,
        <0x0 0x03022000 0 0x2000>,
        <0x0 0x03024000 0 0x2000>,
        <0x0 0x03026000 0 0x2000>;
  interrupts = <1 9 0xf04>;
  interrupt-parent = <&gic>;
 };
 aliases:aliases@45100000 {
  pwmchip0 = &pwmchip0;
  pwmchip1 = &pwmchip1;
  pwmchip2 = &pwmchip2;
  pwm0 = &pwm0;
  pwm1 = &pwm1;
  pwm2 = &pwm2;
  pwm3 = &pwm3;
  pwm4 = &pwm4;
  pwm19 = &pwm19;
  twi1 = &twi1;
  twi2 = &twi2;
  twi6 = &twi6;
  twi7 = &twi7;
  pmu0 = &pmu0;
 };

};

