&sdc0_pins_a {
  allwinner,pins = "PF0", "PF1",
     "PF3", "PF4", "PF5";
  allwinner,function = "sdc0";
  allwinner,muxsel = <2>;
  allwinner,drive = <0>;
  allwinner,pull = <1>;
};

&sdc0_pins_b {
  allwinner,pins = "PF2";
  allwinner,function = "sdc0";
  allwinner,muxsel = <2>;
  allwinner,drive = <2>;
  allwinner,pull = <1>;
};

&sdc0_pins_c {
  allwinner,pins = "PF0", "PF1", "PF2",
       "PF3", "PF4", "PF5";
  allwinner,function = "uart0_jtag";
  allwinner,muxsel = <3>;
  allwinner,drive = <0>;
  allwinner,pull = <1>;
};

&sdc2_pins_a {
  allwinner,pins = "PC6",
     "PC8", "PC9", "PC10", "PC11",
     "PC13", "PC14", "PC15", "PC16";
  allwinner,function = "sdc2";
  allwinner,muxsel = <3>;
  allwinner,drive = <1>;
  allwinner,pull = <1>;
};

&sdc2_pins_c {
  allwinner,pins = "PC0";
  allwinner,function = "sdc2";
  allwinner,muxsel = <3>;
  allwinner,drive = <3>;
  allwinner,pull = <2>;
};

&sdc2_pins_b {
  allwinner,pins = "PC1", "PC5";
  allwinner,function = "sdc2";
  allwinner,muxsel = <3>;
  allwinner,drive = <3>;
  allwinner,pull = <1>;
};

&pwm3_pin_active {
  allwinner,pins = "PD21";
  allwinner,function = "pwm0_3";
  allwinner,muxsel = <0x9>;
  allwinner,drive = <3>;
  allwinner,pull = <2>;
};

&pwm3_pin_sleep {
  allwinner,pins = "PD21";
  allwinner,function = "io_disabled";
  allwinner,muxsel = <0xf>;
  allwinner,drive = <3>;
  allwinner,pull = <2>;
};

&pwm4_pin_active {
  allwinner,pins = "PD22";
  allwinner,function = "pwm0_4";
  allwinner,muxsel = <0x2>;
  allwinner,drive = <3>;
  allwinner,pull = <2>;
};

&pwm4_pin_sleep {
  allwinner,pins = "PD22";
  allwinner,function = "io_disabled";
  allwinner,muxsel = <0xf>;
  allwinner,drive = <3>;
  allwinner,pull = <2>;
};

&card0_boot_para {


 device_type = "card0_boot_para";
 card_ctrl = <0x0>;
 card_high_speed = <0x1>;
 card_line = <0x4>;
 clk_mmc = "sdmmc0_mod";
 pll-0 = "hosc";
 pll-1 = "pll_periph1_400m";
 pll-2 = "pll_periph1_300m";
 pinctrl-0 = <&sdc0_pins_a &sdc0_pins_b>;
 clk_type = "typ1";
};

&card2_boot_para {




 reg = <0x0 0x3 0x0 0x0>;
 device_type = "card2_boot_para";
 card_ctrl = <0x2>;
 card_high_speed = <0x1>;
 card_line = <0x8>;
 clk_mmc = "sdmmc2_mod";
 pll-0 = "hosc";
 pll-1 = "pll_periph1_800m";
 pll-2 = "pll_periph1_600m";
 pinctrl-0 = <&sdc2_pins_a &sdc2_pins_c &sdc2_pins_b>;
 sdc_ex_dly_used = <0x2>;
 sdc_tm4_hs200_max_freq = <200>;
 sdc_tm4_hs400_max_freq = <200>;
 sdc_tm4_win_th = <0x7>;
 sdc_io_1v8 = <0x1>;
 sdc_type = "tm4";
 clk_type = "typ1";
 status = "okay";
};

&key_boot_recovery {
 device_type = "key_boot_recovery";
 recovery_key_used = <0x1>;
 press_mode_enable = <0x0>;
 key_work_mode = <0x2>;
 short_press_mode = <0x0>;
 long_press_mode = <0x1>;
 key_press_time = <0x7d0>;
 recovery_key = <&pio 11 8 0 1 3 1>;
};

&de {
 chn_cfg_mode = <2>;
 status = "okay";
};

&tv0 {
 status = "okay";
};

&clk_de0 {
    assigned-clock-rates = <696000000>;
};

&vo0 {
 status = "okay";
};

&lcd0 {
 status = "okay";
};

&dsi0 {
 status = "okay";
 pinctrl-0 = <&dsi0_4lane_pins_a>;
 pinctrl-1 = <&dsi0_4lane_pins_b>;
 pinctrl-names = "active","sleep";
 ports {
  dsi0_out: port@1{
   dsi_out_panel: endpoint {
    remote-endpoint = <&panel_input>;
   };
  };
 };
 panel: panel@0 {
  compatible = "allwinner,virtual-panel";
  status = "okay";
  reg = <0>;
  ports {
   panel_in: port@0 {
    reg = <0>;
    panel_input: endpoint@0 {
     reg = <0>;
     remote-endpoint = <&dsi_out_panel>;
    };
   };
   panel_out: port@1 {
    reg = <1>;
    panel_output_0: endpoint@0 {
     reg = <0>;
     remote-endpoint = <&panel0_in>;
    };
    panel_output_1: endpoint@1 {
     reg = <1>;
     remote-endpoint = <&panel1_in>;
    };
   };
  };
 };
};

&dsi0combophy {
 status = "okay";
};

&route_dsi0 {
 status = "okay";
 logo,uboot = "bootlogo.bmp";
};

&route_lvds0 {
 status = "disabled";
};

&route_hdmi {
 status = "okay";
};

&hdmi {
 uhdmi_fast_output = <1>;
 status = "okay";
};

&pwm3{
 pinctrl-names = "active","sleep";
 pinctrl-0 = <&pwm3_pin_active>;
 pinctrl-1 = <&pwm3_pin_sleep>;
 status = "okay";
};

&pwm4{
 pinctrl-names = "active","sleep";
 pinctrl-0 = <&pwm4_pin_active>;
 pinctrl-1 = <&pwm4_pin_sleep>;
 status = "disabled";
};

&aliases {
 ocp2131 = &ocp2131;
};

&dram_para_select_pin {
 allwinner,pins = "PH16";
 allwinner,function = "gpio_in";
 allwinner,muxsel = <0>;
 allwinner,drive = <0>;
 allwinner,pull = <1>;
};

&sunxi_dram_para_select {
 pinctrl-0 = <&dram_para_select_pin>;
 select_mode = <3>;
 gpadc_channel = <1>;
 status = "okay";
};

&hdmi {
 dcdc2-supply = <&reg_dcdc2>;
 hdmi_power0 = "dcdc2";
 hdmi_power_cnt = <1>;
# 748 "arch/arm/dts/.board-uboot.dts"
 uhdmi_fast_output = <0>;
 uhdmi_resistor_select = <1>;

 snps_phy = <
   25000 165000 0x0007 0x280 0x8082
  165000 340000 0x0004 0x8240 0x80C3
  340000 600000 0x0000 0x200 0x80F9>;

 status = "okay";
};
