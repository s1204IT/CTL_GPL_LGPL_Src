 status = "okay";

 ocp2131: ocp2131@3e {
  compatible = "general,ocp2131";
  reg = <0x3e>;
  status = "okay";
  regulator1: regulators@1 {
   reg_avdd: ocp2131-avdd {
    regulator-name = "ocp2131-avdd";
   };
