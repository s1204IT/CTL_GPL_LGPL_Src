	soc@29000000 {
		compatible = "simple-bus";
		#address-cells = <0x2>;
		#size-cells = <0x2>;

		pinctrl@07025000 {

			s_twi0@0 {
				allwinner,pins = "PL0", "PL1";
				allwinner,pname = "s_twi0_scl", "s_twi0_sda";
				allwinner,function = "s_twi0";
				allwinner,muxsel = <0x2>;
				allwinner,drive = <0x1>;
				allwinner,pull = <0x1>;
				phandle = <0x17>;
			};

			s_twi0@1 {
				allwinner,pins = "PL0", "PL1";
				allwinner,function = "gpio_out";
				allwinner,muxsel = <0x1>;
				allwinner,drive = <0x1>;
				allwinner,pull = <0x1>;
				phandle = <0x18>;
			};
		};

		twi@0x2511000 {
			clock-frequency = <0x61a80>;
			pinctrl-0 = <0x11>;
			pinctrl-1 = <0x12>;
			twi-supply = <0x13>;
			status = "okay";
		};

		twi@0x2512000 {
			clock-frequency = <0x61a80>;
			pinctrl-0 = <0x14>;
			pinctrl-1 = <0x15>;
			twi-supply = <0x16>;
			status = "okay";
		};

		s_twi@0x07083000 {
			clock-frequency = <0x30d40>;
			pinctrl-0 = <0x17>;
			pinctrl-1 = <0x18>;
			twi-supply = <0x19>;
			status = "okay";

			pmu@34 {
			};

			pmu@36 {
				compatible = "x-powers,axp8191";
				reg = <0x36>;
				status = "okay";

				regulators@0 {

					dcdc1 {
						regulator-name = "axp8191-dcdc1";
						phandle = <0x1a>;
					};

					dcdc2 {
						regulator-name = "axp8191-dcdc2";
						phandle = <0x8b>;
					};

					dcdc3 {
						regulator-name = "axp8191-dcdc3";
					};

					dcdc4 {
						regulator-name = "axp8191-dcdc4";
					};

					dcdc5 {
						regulator-name = "axp8191-dcdc5";
					};

					dcdc6 {
						regulator-name = "axp8191-dcdc6";
					};

					dcdc7 {
						regulator-name = "axp8191-dcdc7";
					};

					dcdc8 {
						regulator-name = "axp8191-dcdc8";
					};

					dcdc9 {
						regulator-name = "axp8191-dcdc9";
					};

					rtcldo {
						regulator-name = "axp8191-rtcldo";
					};

					aldo1 {
						regulator-name = "axp8191-aldo1";
					};

					aldo2 {
						regulator-name = "axp8191-aldo2";
					};

					aldo3 {
						regulator-name = "axp8191-aldo3";
						phandle = <0x19>;
					};

					aldo4 {
						regulator-name = "axp8191-aldo4";
					};

					aldo5 {
						regulator-name = "axp8191-aldo5";
					};

					aldo6 {
						regulator-name = "axp8191-aldo6";
					};

					bldo1 {
						regulator-name = "axp8191-bldo1";
					};

					bldo2 {
						regulator-name = "axp8191-bldo2";
						phandle = <0x16>;
					};

					bldo3 {
						regulator-name = "axp8191-bldo3";
					};

					bldo4 {
						regulator-name = "axp8191-bldo4";
					};

					bldo5 {
						regulator-name = "axp8191-bldo5";
					};

					cldo1 {
						regulator-name = "axp8191-cldo1";
					};

					cldo2 {
						regulator-name = "axp8191-cldo2";
					};

					cldo3 {
						regulator-name = "axp8191-cldo3";
					};

					cldo4 {
						regulator-name = "axp8191-cldo4";
					};

					cldo5 {
						regulator-name = "axp8191-cldo5";
					};

					dldo1 {
						regulator-name = "axp8191-dldo1";
					};

					dldo2 {
						regulator-name = "axp8191-dldo2";
					};

					dldo3 {
						regulator-name = "axp8191-dldo3";
					};

					dldo4 {
						regulator-name = "axp8191-dldo4";
					};

					dldo5 {
						regulator-name = "axp8191-dldo5";
					};

					dldo6 {
						regulator-name = "axp8191-dldo6";
					};

					eldo1 {
						regulator-name = "axp8191-eldo1";
					};

					eldo2 {
						regulator-name = "axp8191-eldo2";
					};

					eldo3 {
						regulator-name = "axp8191-eldo3";
					};

					eldo4 {
						regulator-name = "axp8191-eldo4";
					};

					eldo5 {
						regulator-name = "axp8191-eldo5";
					};

					eldo6 {
						regulator-name = "axp8191-eldo6";
					};

					dc1sw1 {
						regulator-name = "axp8191-dc1sw1";
						swin-supply = <0x1a>;
						phandle = <0x8e>;
					};

					dc1sw2 {
						regulator-name = "axp8191-dc1sw2";
						swin-supply = <0x1a>;
						phandle = <0x13>;
					};
				};
			};
		};

		twi@2517000 {
			clock-frequency = <0x61a80>;
			pinctrl-0 = <0x1b>;
			pinctrl-1 = <0x1c>;
			twi-supply = <0x16>;
			status = "okay";

			ocp2131@3e {
				compatible = "general,ocp2131";
				reg = <0x3e>;
				status = "okay";

				regulators@1 {

					ocp2131-avdd {
						regulator-name = "ocp2131-avdd";
					};

					ocp2131-avee {
						regulator-name = "ocp2131-avee";
					};
				};
			};
		};

		power_sply@4500000c {
			device_type = "power_sply";
			ntc_status = <0x2>;
		};

		power_delay@4500024 {
			device_type = "power_delay";
		};

		platform@45000004 {
			device_type = "platform";
			eraseflag = <0x1>;
			next_work = <0x3>;
			debug_mode = <0x4>;
		};

		target@45000008 {
			device_type = "target";
			boot_clock = <0x3f0>;
			storage_type = <0xffffffff>;
			burn_key = <0x1>;
			dragonboard_test = <0x0>;
			auto_fel = <0x1>;
		};

		charger0@45000010 {
			device_type = "charger0";
			pmu_safe_vol = <0xd48>;
			bat_bmp_type = <0x1>;
			ntc_cur = <0x3c>;
			safe_temp_H = <0x258>;
			safe_temp_L = <0xffffff06>;
			pmu_bat_temp_para1 = <0x154a>;
			pmu_bat_temp_para2 = <0xcf3>;
			pmu_bat_temp_para3 = <0xa38>;
