		sid@3006000 {
			compatible = "allwinner,sunxi-sid";
			reg = <0x0 0x03006000 0 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;
			non-secure-maxoffset = <0x80>;
			non-secure-maxlen = <0x20>;

			secure_status {
				reg = <0x0 0>;
				offset = <0xa0>;
				size = <0x4>;
			};
			chipid {
				reg = <0x0 0>;
				offset = <0x200>;
				size = <0x10>;
			};
			rotpk {
				reg = <0x0 0>;
				offset = <0x140>;
				size = <0x20>;
			};
			ecc {
				offset = <0x240>;
				shift = <0x14>;
				mask = <0x1>;
			};
		};

		sram_ctrl: sram_ctrl@3000000 {
			compatible = "allwinner,sram_ctrl";
			reg = <0x0 0x03000000 0 0x184>;
			soc_ver {
				offset = <0x24>;
				mask = <0x7>;
				shift = <0>;
			};
		};

		nsi0: nsi-controller@2020000 {
			compatible = "allwinner,sunxi-nsi-v2";
			interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0x02020000 0x0 0x10000>;
			clocks = <&ccu CLK_PLL_DDR>, <&ccu CLK_MBUS>, <&ccu CLK_LBC>,
				<&ccu CLK_NSI>, <&ccu CLK_PLL_DDR>,
				<&ccu CLK_GIC>, <&ccu CLK_AHB>,
				<&ccu CLK_SERDES_AXI>, <&ccu CLK_GMAC_NSI>, <&ccu CLK_DRAM>;
			clock-names = "pll", "bus", "lbc",
					"nsi", "nsi-p",
					"gic", "ahb", "serdes", "gmac", "dram";
			resets = <&ccu RST_BUS_NSI>, <&ccu RST_BUS_NSI_CFG>;
			reset-names = "bus_nsi", "bus_nsi_cfg";
			clock-frequency = <600000000>, <600000000>;
			#nsi-cells = <1>;
			support-ecc = <1>;
			ra_pmu_data_unit = <64>;
			clk_path_type = <1>;
			topology_type = <2>;
			channel_type = <1>;
			master_clks = <0 9>, <1 5>, <2 1>, <3 1>, <4 1>, <5 1>, <6 1>, <7 3>, <8 1>, <9 7>,
					<10 1>, <11 3>, <12 2>, <13 8>, <14 3>, <15 3>, <16 1>, <17 3>, <18 3>, <19 6>,
					<20 6>, <21 6>, <22 6>, <23 6>, <24 6>, <25 6>;

			iommu {
				id = <6>;
				mode = <0>;
				pri = <3>;
				select = <1>;
			};

			de {
				id = <4>;
				mode = <0>;
				pri = <2>;
				select = <1>;
			};

			ve {
				id = <5>;
				mode = <0>;
				pri = <2>;
				select = <1>;
			};

			isp {
				id = <2>;
				mode = <0>;
				pri = <2>;
				select = <1>;
			};

			csi {
				id = <3>;
				mode = <0>;
				pri = <2>;
				select = <1>;
			};
		};

		g2d: g2d@5440000 {
