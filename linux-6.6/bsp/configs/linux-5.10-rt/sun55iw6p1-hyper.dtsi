		ve: ve@1c0e000 {
			compatible = "allwinner,sunxi-cedar-ve";
			reg = <0x0 0x01c0e000 0x0 0x1000>,      /* ve */
				  <0x0 0x03000000 0x0 0x10>;        /* syscfg */
			interrupts = <GIC_SPI 120 IRQ_TYPE_LEVEL_HIGH>; /* VE0: 152-32 */
			clocks = <&ccu CLK_BUS_VE>,
					<&ccu CLK_VE>,
					<&ccu CLK_MBUS_VE_GATE>;
			clock-names = "bus_ve", "ve", "mbus_ve";
			resets = <&ccu RST_BUS_VE>;
			reset-names = "reset_ve";
			ve_top_reg_offset = <0x800>; /*should check with ve spec*/
			iommus = <&mmu_aw 2 1>;
			power-domains = <&pd MR536_PCK_VE>;
			status = "disabled";
		};

		lbc: lbc-controller@2810000 {
			compatible = "allwinner,sunxi-lbc";
			clock-frequency = <50000000>;
			reg = <0x0 0x02810000 0x0 0x1000>,
				  <0x0 0x10000000 0x0 0x8000000>;
			reg-names = "reg_addr", "data_addr";
			interrupts = <GIC_SPI 48 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_PLL_PERI0_400M>, <&ccu CLK_PLL_PERI0_200M>,
					 <&ccu CLK_LBC_NSI_AHB>, <&ccu CLK_BUS_LBC>, <&ccu CLK_LBC>;
			clock-names = "lbc_pll", "lbc_nsi_pll", "lbc_nsi_ahb", "bus_lbc", "lbc";
			resets = <&ccu RST_BUS_LBC>;
			reset-names = "lbc_rst";
			reset-fpga-gpios = <&pio PA 7 GPIO_ACTIVE_LOW>;
			async-tx-fifo-size = "64";
			async-rx-fifo-size = "64";
			status = "disabled";
		};

		gmac_stmmac_axi_setup: stmmac-axi-config {
			snps,wr_osr_lmt = <0xf>;
			snps,rd_osr_lmt = <0xf>;
			snps,blen = <256 128 64 32 16 8 4>;
		};

		gmac_mtl_rx_setup: rx-queues-config {
			snps,rx-queues-to-use = <1>;
			queue0 {};
		};

		gmac_mtl_tx_setup: tx_queues-config {
			snps,tx-queues-to-use = <1>;
			queue0 {};
		};

		gmac0: ethernet@4500000 {
			compatible = "allwinner,sunxi-gmac-220", "snps,dwmac-5.10a";
			reg = <0x0 0x04500000 0x0 0x8000>,
				  <0x0 0x04508000 0x0 0x8000>;
			interrupts = <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq";
			clocks = <&ccu CLK_GMAC0>, <&ccu CLK_MBUS_GMAC0_GATE>, <&ccu CLK_GMAC0_PHY>,
					<&ccu CLK_GMAC0_PTP>, <&ccu CLK_GMAC_NSI>;
			clock-names = "stmmaceth", "pclk", "phy", "ptp_ref", "nsi";
			assigned-clocks = <&ccu CLK_GMAC_NSI>, <&ccu CLK_GMAC0_PHY>;
			assigned-clock-parents = <&ccu CLK_PLL_PERI0_480M>;
			assigned-clock-rates = <480000000>, <25000000>;
			resets = <&ccu RST_BUS_GMAC0_AXI>, <&ccu RST_BUS_GMAC0>;
			reset-names = "stmmaceth", "ahb";
			phy-handle = <&gmac0_phy0>;
			status = "disabled";

			snps,fixed-burst;
			snps,axi-config = <&gmac_stmmac_axi_setup>;
			snps,mtl-rx-config = <&gmac_mtl_rx_setup>;
			snps,mtl-tx-config = <&gmac_mtl_tx_setup>;

			aw,rgmii-clk-ext;

			mdio0: mdio0@0 {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
				gmac0_phy0: ethernet-phy@1 {
					compatible = "ethernet-phy-ieee802.3-c22";
					reg = <0x1>;
					max-speed = <1000>;  /* Max speed capability */
					reset-gpios = <&pio PB 7 GPIO_ACTIVE_LOW>;
					/* PHY datasheet rst time */
					reset-assert-us = <10000>;
					reset-deassert-us = <150000>;
				};
			};
		};

		gmac1: ethernet@4510000 {
			compatible = "allwinner,sunxi-gmac-220", "snps,dwmac-5.10a";
			reg = <0x0 0x04510000 0x0 0x8000>,
				  <0x0 0x04518000 0x0 0x8000>;
			interrupts = <GIC_SPI 47 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq";
			clocks = <&ccu CLK_GMAC1>, <&ccu CLK_MBUS_GMAC1_GATE>, <&ccu CLK_GMAC1_PHY>,
					<&ccu CLK_GMAC1_PTP>, <&ccu CLK_GMAC_NSI>;
			clock-names = "stmmaceth", "pclk", "phy", "ptp_ref", "nsi";
			assigned-clocks = <&ccu CLK_GMAC_NSI>, <&ccu CLK_GMAC1_PHY>;
			assigned-clock-parents = <&ccu CLK_PLL_PERI0_480M>;
			assigned-clock-rates = <480000000>, <25000000>;
			resets = <&ccu RST_BUS_GMAC1_AXI>, <&ccu RST_BUS_GMAC1>;
			reset-names = "stmmaceth", "ahb";
			phy-handle = <&gmac1_phy0>;
			status = "disabled";

			snps,fixed-burst;
			snps,axi-config = <&gmac_stmmac_axi_setup>;
			snps,mtl-rx-config = <&gmac_mtl_rx_setup>;
			snps,mtl-tx-config = <&gmac_mtl_tx_setup>;
			aw,rgmii-clk-ext;

			mdio1: mdio1@0 {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
				gmac1_phy0: ethernet-phy@1 {
					compatible = "ethernet-phy-ieee802.3-c22";
					reg = <0x1>;
					max-speed = <1000>;  /* Max speed capability */
					reset-gpios = <&pio PB 8 GPIO_ACTIVE_LOW>;
					/* PHY datasheet rst time */
					reset-assert-us = <10000>;
					reset-deassert-us = <150000>;
				};
			};
		};
	};

	soc2: soc@2 {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		device_type = "guest-soc";
		kylo-os-id = <2>;

		pio1: pinctrl@1 {
			//#address-cells = <1>;
			//#size-cells = <0>;
			compatible = "allwinner,sun55iw6-pinctrl";
			reg = <0x0 0x03604000 0x0 0x600>;
#if 0
			interrupts = <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 71 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 73 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>;
#endif
			clocks = <&ccu CLK_APB1>, <&dcxo24M>, <&rtc_ccu CLK_OSC32K>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <3>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};

		r_pio1: pinctrl@11 {
			#address-cells = <1>;
			compatible = "allwinner,sun55iw6-r-pinctrl";
			reg = <0x0 0x07096000 0x0 0x800>;
#if 0
			interrupts = <GIC_SPI 202 IRQ_TYPE_LEVEL_HIGH>, /* GPIOL */
						 <GIC_SPI 204 IRQ_TYPE_LEVEL_HIGH>;     /* GPIOM */
#endif
			clocks = <&ccu CLK_R_APBS1>, <&dcxo24M>, <&rtc_ccu CLK_OSC32K>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <3>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};

		uart8: uart@2608000 {
			compatible = "allwinner,uart-v100";
			device_type = "uart8";
			reg = <0x0 0x02608000 0x0 0x400>;
			interrupts = <GIC_SPI 148 IRQ_TYPE_LEVEL_HIGH>;
			sunxi,uart-fifosize = <128>;
			clocks = <&ccu CLK_BUS_UART8>;
			resets = <&ccu RST_BUS_UART8>;
			uart8_port = <8>;
			uart8_type = <4>;
			//dmas = <&dma0 55>,<&dma0 55>;
			//dma-names = "tx","rx";
			status = "disabled";
		};


	};

	soc3: soc@3 {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		device_type = "guest-soc";
		kylo-os-id = <3>;

		pio2: pinctrl@2 {
			//#address-cells = <1>;
			//#size-cells = <0>;
			compatible = "allwinner,sun55iw6-pinctrl";
			reg = <0x0 0x03604000 0x0 0x600>;
#if 0
			interrupts = <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 71 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 73 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>,
							 <GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>;
#endif
			clocks = <&ccu CLK_APB1>, <&dcxo24M>, <&rtc_ccu CLK_OSC32K>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <3>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};

		r_pio2: pinctrl@22 {
			#address-cells = <1>;
			compatible = "allwinner,sun55iw6-r-pinctrl";
			reg = <0x0 0x07096000 0x0 0x800>;
#if 0
			interrupts = <GIC_SPI 202 IRQ_TYPE_LEVEL_HIGH>, /* GPIOL */
							<GIC_SPI 204 IRQ_TYPE_LEVEL_HIGH>;     /* GPIOM */
#endif
			clocks = <&ccu CLK_R_APBS1>, <&dcxo24M>, <&rtc_ccu CLK_OSC32K>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <3>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};

		uart2: uart@2602000 {
			compatible = "allwinner,uart-v100";
			device_type = "uart2";
			reg = <0x0 0x02602000 0x0 0x400>;
			interrupts = <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>;
			sunxi,uart-fifosize = <128>;
			clocks = <&ccu CLK_BUS_UART2>;
			resets = <&ccu RST_BUS_UART2>;
			uart2_port = <2>;
			uart2_type = <4>;
			//dmas = <&dma0 16>,<&dma0 16>;
			//dma-names = "tx","rx";
			status = "disabled";
		};
	};


};

