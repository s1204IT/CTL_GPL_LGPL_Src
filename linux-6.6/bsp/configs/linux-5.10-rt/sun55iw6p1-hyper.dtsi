			core-clock-frequency = <600000000>;
			axi-clock-frequency = <300000000>;
			clocks = <&ccu CLK_PLL_PERI0_600M>, <&ccu CLK_RV_CORE>, <&ccu CLK_RV_TS>, <&ccu CLK_RV_CFG>, <&ccu CLK_E907_AXI>;
