/{
	vf_mapping_table: vf_mapping_table {
		vf-version = "V0.74";
		table = <
			0x00 0x0000
			0x01 0x0100
			0x02 0x0200
			0x12 0x0201
			0x22 0x0202
			0x32 0x0203
			0x03 0x0300
			>;
	};

	cluster_opp_table: cluster-opp-table {
		compatible = "allwinner,sun50i-operating-points";
		opp-shared;

		opp@408000000 {
			opp-hz = /bits/ 64 <408000000>;
			clock-latency-ns = <244144>; /* 8 32k periods */
			opp-microvolt-vf0000 = <920000>;
			opp-microvolt-vf0100 = <900000>;
			opp-microvolt-vf0200 = <900000>;
			opp-microvolt-vf0201 = <900000>;
			opp-microvolt-vf0202 = <900000>;
			opp-microvolt-vf0203 = <900000>;
			opp-microvolt-vf0300 = <900000>;
		};

		opp@720000000 {
			opp-hz = /bits/ 64 <720000000>;
			clock-latency-ns = <244144>; /* 8 32k periods */
			opp-microvolt-vf0000 = <920000>;
			opp-microvolt-vf0100 = <900000>;
			opp-microvolt-vf0200 = <900000>;
			opp-microvolt-vf0201 = <900000>;
			opp-microvolt-vf0202 = <900000>;
			opp-microvolt-vf0203 = <900000>;
			opp-microvolt-vf0300 = <900000>;
		};

		opp@1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			clock-latency-ns = <244144>; /* 8 32k periods */
			opp-microvolt-vf0000 = <920000>;
			opp-microvolt-vf0100 = <920000>;
			opp-microvolt-vf0200 = <900000>;
			opp-microvolt-vf0201 = <900000>;
			opp-microvolt-vf0202 = <900000>;
			opp-microvolt-vf0203 = <900000>;
			opp-microvolt-vf0300 = <900000>;
		};

		opp@1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			clock-latency-ns = <244144>; /* 8 32k periods */
			opp-microvolt-vf0000 = <920000>;
			opp-microvolt-vf0100 = <960000>;
			opp-microvolt-vf0200 = <920000>;
			opp-microvolt-vf0201 = <920000>;
			opp-microvolt-vf0202 = <920000>;
			opp-microvolt-vf0203 = <920000>;
			opp-microvolt-vf0300 = <900000>;
		};

		opp@1392000000 {
			opp-hz = /bits/ 64 <1392000000>;
			clock-latency-ns = <244144>; /* 8 32k periods */
			opp-microvolt-vf0000 = <960000>;
			opp-microvolt-vf0100 = <1000000>;
			opp-microvolt-vf0200 = <960000>;
			opp-microvolt-vf0201 = <960000>;
			opp-microvolt-vf0202 = <960000>;
			opp-microvolt-vf0203 = <960000>;
			opp-microvolt-vf0300 = <940000>;
		};

		opp@1512000000 {
			opp-hz = /bits/ 64 <1512000000>;
			clock-latency-ns = <244144>; /* 8 32k periods */
			opp-microvolt-vf0000 = <0>;
			opp-microvolt-vf0100 = <1060000>;
			opp-microvolt-vf0200 = <1020000>;
			opp-microvolt-vf0201 = <1000000>;
			opp-microvolt-vf0202 = <1000000>;
			opp-microvolt-vf0203 = <1020000>;
			opp-microvolt-vf0300 = <980000>;
		};

		opp@1608000000 {
			opp-hz = /bits/ 64 <1608000000>;
			clock-latency-ns = <244144>; /* 8 32k periods */
			opp-microvolt-vf0000 = <1050000>;
			opp-microvolt-vf0100 = <1120000>;
			opp-microvolt-vf0200 = <1060000>;
			opp-microvolt-vf0201 = <1040000>;
			opp-microvolt-vf0202 = <1040000>;
			opp-microvolt-vf0203 = <1060000>;
			opp-microvolt-vf0300 = <1020000>;
		};

		opp@1704000000 {
			opp-hz = /bits/ 64 <1704000000>;
			clock-latency-ns = <244144>; /* 8 32k periods */
			opp-microvolt-vf0000 = <0>;
			opp-microvolt-vf0100 = <0>;
			opp-microvolt-vf0200 = <1120000>;
			opp-microvolt-vf0201 = <1100000>;
			opp-microvolt-vf0202 = <0>;
			opp-microvolt-vf0203 = <0>;
			opp-microvolt-vf0300 = <1080000>;
		};

		opp@1752000000 {
			opp-hz = /bits/ 64 <1752000000>;
			clock-latency-ns = <244144>; /* 8 32k periods */
			opp-microvolt-vf0000 = <0>;
			opp-microvolt-vf0100 = <0>;
			opp-microvolt-vf0200 = <1150000>;
			opp-microvolt-vf0201 = <0>;
			opp-microvolt-vf0202 = <0>;
			opp-microvolt-vf0203 = <0>;
			opp-microvolt-vf0300 = <0>;
		};

		opp@1800000000 {
			opp-hz = /bits/ 64 <1800000000>;
			clock-latency-ns = <244144>; /* 8 32k periods */
			opp-microvolt-vf0000 = <1150000>;
			opp-microvolt-vf0100 = <0>;
			opp-microvolt-vf0200 = <0>;
			opp-microvolt-vf0201 = <1150000>;
			opp-microvolt-vf0202 = <0>;
			opp-microvolt-vf0203 = <0>;
			opp-microvolt-vf0300 = <1120000>;
		};
	};

