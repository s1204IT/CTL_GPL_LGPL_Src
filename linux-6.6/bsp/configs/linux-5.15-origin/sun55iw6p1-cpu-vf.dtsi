	ve_opp_table: ve-opp-table {
		compatible = "allwinner,ve-operating-points";

		opp-vf0000 {
			opp-hz-0 = /bits/ 64 <456000000>;
			opp-microvolt-0 = <920000>;
		};
		opp-vf0100 {
			opp-hz-0 = /bits/ 64 <408000000>;
			opp-microvolt-0 = <940000>;
			opp-hz-1 = /bits/ 64 <528000000>;
			opp-microvolt-1 = <1000000>;
		};
		opp-vf0200 {
			opp-hz-0 = /bits/ 64 <408000000>;
			opp-microvolt-0 = <920000>;
			opp-hz-1 = /bits/ 64 <528000000>;
			opp-microvolt-1 = <980000>;
		};
		opp-vf0201 {
			opp-hz-0 = /bits/ 64 <408000000>;
			opp-microvolt-0 = <940000>;
			opp-hz-1 = /bits/ 64 <528000000>;
			opp-microvolt-1 = <980000>;
		};
		opp-vf0202 {
			opp-hz-0 = /bits/ 64 <408000000>;
			opp-microvolt-0 = <940000>;
			opp-hz-1 = /bits/ 64 <528000000>;
			opp-microvolt-1 = <980000>;
		};
		opp-vf0203 {
			opp-hz-0 = /bits/ 64 <408000000>;
			opp-microvolt-0 = <940000>;
			opp-hz-1 = /bits/ 64 <528000000>;
			opp-microvolt-1 = <980000>;
		};
		opp-vf0300 {
			opp-hz-0 = /bits/ 64 <408000000>;
			opp-microvolt-0 = <920000>;
			opp-hz-1 = /bits/ 64 <528000000>;
			opp-microvolt-1 = <960000>;
		};
	};

	npu_opp_table: npu-opp-table {
		compatible = "allwinner,sun55i-operating-points";

		npu_opp_table_328: opp-328 {
