/* SPDX-License-Identifier: GPL-2.0-or-later */
/*
 * Allwinner Technology CO., Ltd. sun8iw17p1 platform
 *
 * modify base on juno.dts
 */

/* nobody use, just to "avoid"(not reslove) OOM problem at the begining of the physical memory address. */
/memreserve/ 0x40000000 0x00001000; /* reserve for out of memory access problem: size = 4K */

/* kernel used */
/memreserve/ 0x43000000 0x00000800; /* super standby range        : [0x40020000~0x41020800], size = 2K  */
/memreserve/ 0x48000000 0x01000000; /* atf                        : [0x48000000~0x49000000], size = 16M */

/* tf used */
/memreserve/ 0x48100000 0x00004000; /* arisc dram code space range: [0x48100000~0x48104000], size = 16K */
/memreserve/ 0x48104000 0x00001000; /* arisc para cfg range       : [0x48104000~0x48105000], size = 4K  */
/memreserve/ 0x48105000 0x00001000; /* arisc message pool range   : [0x48105000~0x48106000], size = 4K  */

/* pstore used */
/memreserve/ 0x48106000 0x00100000; /* ram oops log range   : [0x48106000~0x48206000], size = 1M  */
/memreserve/ 0x48200000 0x00100000; /* 360 config  size = 1M  */

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/gpio/gpio.h>
#include "sun8iw17p1-clk.dtsi"
#include <dt-bindings/gpio/sun4i-gpio.h>
#include <dt-bindings/spi/sunxi-spi.h>
#include <dt-bindings/reset/sun8iw17-ccu.h>
#include <dt-bindings/reset/sun8iw17-r-ccu.h>
/ {
	model = "sun8iw17p1";
	compatible = "allwinner,sun8iw17p1";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		serial5 = &uart5;
		serial6 = &uart6;
		serial7 = &uart7;
		serial8 = &uart8;
		serial9 = &uart9;
		twi0 = &twi0;
		twi1 = &twi1;
		twi2 = &twi2;
		twi3 = &twi3;
		twi4 = &twi4;
		twi5 = &twi5;
		twi6 = &twi6;
		twi7 = &s_twi0;
		twi8 = &s_twi1;
		twi9 = &s_twi2;
		spi0 = &spi0;
		spi1 = &spi1;
		spi2 = &s_spi0;
		pwm0 = &pwm;
		pwm1 = &s_pwm;
		gpadc0 = &gpadc0;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x0>;
			enable-method = "psci";
			clocks = <&clk_pll_cpu0>;
			clock-latency = <2000000>;
			clock-frequency = <1008000000>;
			operating-points-v2 = <&cpu_opp_l_table>;
			#cooling-cells = <2>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x1>;
			enable-method = "psci";
			clocks = <&clk_pll_cpu0>;
			clock-frequency = <1008000000>;
			operating-points-v2 = <&cpu_opp_l_table>;
			#cooling-cells = <2>;
		};

		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x2>;
			enable-method = "psci";
			clocks = <&clk_pll_cpu0>;
			clock-frequency = <1008000000>;
			operating-points-v2 = <&cpu_opp_l_table>;
			#cooling-cells = <2>;
		};

		cpu3: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x100>;
			enable-method = "psci";
			clocks = <&clk_pll_cpu1>;
			clock-frequency = <1008000000>;
			operating-points-v2 = <&cpu_opp_b_table>;
			#cooling-cells = <2>;
		};

		cpu4: cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x101>;
			enable-method = "psci";
			clocks = <&clk_pll_cpu1>;
			clock-frequency = <1008000000>;
			operating-points-v2 = <&cpu_opp_b_table>;
			#cooling-cells = <2>;
		};

		cpu5: cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x102>;
			clocks = <&clk_pll_cpu1>;
			enable-method = "psci";
			clock-frequency = <1008000000>;
			operating-points-v2 = <&cpu_opp_b_table>;
			#cooling-cells = <2>;
		};
	};

	cpu_opp_l_table: cpu_opp_l_table {
		compatible = "operating-points-v2";
		opp-shared;

		opp@600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <1060000>;
			clock-latency-ns = <2000000>;
		};

		opp@720000000 {
			opp-hz = /bits/ 64 <720000000>;
			opp-microvolt = <1060000>;
			clock-latency-ns = <2000000>;
		};

		opp@912000000 {
			opp-hz = /bits/ 64 <912000000>;
			opp-microvolt = <1200000>;
			clock-latency-ns = <2000000>;
		};

		opp@1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt = <1260000>;
			clock-latency-ns = <2000000>;
		};

		opp@1104000000 {
			opp-hz = /bits/ 64 <1104000000>;
			opp-microvolt = <1300000>;
			clock-latency-ns = <2000000>;
		};
	};

	cpu_opp_b_table: cpu_opp_b_table {
		compatible = "operating-points-v2";
		opp-shared;

		opp@600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <1060000>;
			clock-latency-ns = <2000000>;
		};

		opp@720000000 {
			opp-hz = /bits/ 64 <720000000>;
			opp-microvolt = <1060000>;
			clock-latency-ns = <2000000>;
		};

		opp@912000000 {
			opp-hz = /bits/ 64 <912000000>;
			opp-microvolt = <1200000>;
			clock-latency-ns = <2000000>;
		};

		opp@1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt = <1260000>;
			clock-latency-ns = <2000000>;
		};

		opp@1104000000 {
			opp-hz = /bits/ 64 <1104000000>;
			opp-microvolt = <1300000>;
			clock-latency-ns = <2000000>;
		};
	};

	thermal-zones {
		cpu1_thermal_zone {
			polling-delay-passive = <1000>;
			polling-delay = <10000>;
			thermal-sensors = <&ths 0>;

			trips {
				cpu_trip0: t0 {
					temperature = <60000>;
					hysteresis = <0>;
					type = "passive";
				};

				cpu_trip1: t1 {
					temperature = <70000>;
					hysteresis = <0>;
					type = "passive";
				};

				cpu_trip2: t2 {
					temperature = <80000>;
					hysteresis = <0>;
					type = "passive";
				};

				cpu_trip3: t3 {
					temperature = <90000>;
					hysteresis = <0>;
					type = "passive";
				};

				cpu_trip4: t4 {
					temperature = <100000>;
					hysteresis = <0>;
					type = "passive";
				};

				crt_trip0: t5 {
					temperature = <120000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_trip0>;
					cooling-device = <&cpu0 1 1>,
							 <&cpu1 1 1>,
							 <&cpu2 1 1>,
							 <&cpu3 1 1>,
							 <&cpu4 1 1>,
							 <&cpu5 1 1>;
				};

				map1 {
					trip = <&cpu_trip1>;
					cooling-device = <&cpu0 2 2>,
							 <&cpu1 2 2>,
							 <&cpu2 2 2>,
							 <&cpu3 2 2>,
							 <&cpu4 2 2>,
							 <&cpu5 2 2>;
				};

				map2 {
					trip = <&cpu_trip2>;
					cooling-device = <&cpu0 3 3>,
							 <&cpu1 3 3>,
							 <&cpu2 3 3>,
							 <&cpu3 3 3>,
							 <&cpu4 3 3>,
							 <&cpu5 3 3>;
				};

				map3 {
					trip = <&cpu_trip3>;
					cooling-device = <&cpu0 4 4>,
							 <&cpu1 4 4>,
							 <&cpu2 4 4>,
							 <&cpu3 4 4>,
							 <&cpu4 4 4>,
							 <&cpu5 4 4>;
				};

				map4 {
					trip = <&cpu_trip4>;
					cooling-device = <&cpu0 5 5>,
							 <&cpu1 5 5>,
							 <&cpu2 5 5>,
							 <&cpu3 5 5>,
							 <&cpu4 5 5>,
							 <&cpu5 5 5>;
				};
			};
		};

		cpu0_thermal_zone {
			polling-delay-passive = <1000>;
			polling-delay = <10000>;
			thermal-sensors = <&ths 1>;
		};

		ddr_thermal_zone {
			polling-delay-passive = <1000>;
			polling-delay = <10000>;
			thermal-sensors = <&ths 2>;
		};

		gpu_thermal_zone {
			polling-delay-passive = <1000>;
			polling-delay = <10000>;
			thermal-sensors = <&ths 3>;
		};
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00000000 0x40000000 0x00000000 0x20000000>;
	};

	gic: interrupt-controller@03020000 {
		compatible = "arm,cortex-a15-gic", "arm,cortex-a9-gic";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		device_type = "gic";
		interrupt-controller;
		reg = <0x0 0x03021000 0 0x1000>, /* GIC Dist */
		      <0x0 0x03022000 0 0x2000>, /* GIC CPU */
		      <0x0 0x03024000 0 0x2000>, /* GIC VCPU Control */
		      <0x0 0x03026000 0 0x2000>; /* GIC VCPU */
		interrupts = <GIC_PPI 9 0xf04>; /* GIC Maintenence IRQ */
	};

	timer_arch {
		compatible = "arm,armv7-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(6) | IRQ_TYPE_LEVEL_LOW)>, /* Secure Phys IRQ */
			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(6) | IRQ_TYPE_LEVEL_LOW)>; /* Non-secure Phys IRQ */
		clock-frequency = <24000000>;
		arm,cpu-registers-not-fw-configured;
		arm,no-tick-in-suspend;
	};

	soc: soc@03000000 {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		device_type = "soc";

		sid@3006000 {
			compatible = "allwinner,sunxi-sid";
			reg = <0x0 0x03006000 0 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;
			non-secure-maxoffset = <0x40>;
			non-secure-maxlen = <0x16>;

			secure_status {
				offset = <0xa0>;
				size = <0x4>;
			};
			rotpk {
				offset = <0x140>;
				size = <0x4>;
			};
			chipid {
				offset = <0x200>;
				size = <0x10>;
			};
		};

		sram_ctrl: sram_ctrl@3000000 {
			compatible = "allwinner,sram_ctrl";
			reg = <0x0 0x03000000 0 0x1000>;
			soc_ver {
				offset = <0x24>;
				mask = <0x7>;
				shift = <0>;
			};
		};

		arisc_space {
			compatible = "allwinner,arisc_space";
			/* num    dst        offset     size                              */
			space1 = <0x48040000 0x00000000 0x00014000>; /* srama2 code space */
			space2 = <0x48100000 0x00018000 0x00004000>; /* dram code space   */
			space3 = <0x48104000 0x00000000 0x00001000>; /* para space        */
			space4 = <0x48105000 0x00000000 0x00001000>; /* msgpool space     */
		};

		rtc: rtc@7000000 {
			compatible = "allwinner,rtc-v202";
			device_type = "rtc";
			wakeup-source;
			auto_switch;
			reg = <0x0 0x07000000 0x0 0x320>;
			interrupts = <GIC_SPI 133 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_cpurrtc>;
			clock-names = "r-ahb-rtc";
			gpr_cur_pos = <6>;
			gpr_bootcount_pos = <7>;
		};

		r_pio: pinctrl@7022000 {
			compatible = "allwinner,sun8iw17p1-r-pinctrl";
			reg = <0x0 0x07022000 0x0 0x400>;
			interrupts = <GIC_SPI 138 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 139 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_cpurpio>;
			gpio-controller;
			interrupt-controller;
			#interrupt-cells = <3>;
			#size-cells = <0>;
			#gpio-cells = <3>;
		};

		mbus0: mbus-controller@0x04002000 {
			compatible = "allwinner,generic-mbus";
			reg = <0x0 0x04002000 0x0 0x1000>;
			#mbus-cells = <1>;
			status = "okay";
			master_pmu_names = "pmu_cpuddr", "pmu_gpu_ddr", "pmu_ve_ddr",
			"pmu_csi_ddr", "pmu_othddr", "pmu_totddr";
			master_pmu_idxs = <0 1 2 6 4 5>;
			master_port_idxs = <0 1 4 11>;
		};

		soc_timer0: timer@3005000 {
			compatible = "allwinner,hstimer-v100";
			device_type = "soc_timer";
			reg = <0x0 0x03005000 0x0 0x100>;
			interrupts = <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_hosc>, <&clk_hstimer>;
			clock-names = "parent", "bus";
			resets = <&ccu RST_HSTIMER_BGR>;
		};

		pio: pinctrl@300b000 {
			compatible = "allwinner,sun8iw17p1-pinctrl";
			reg = <0x0 0x0300b000 0x0 0x400>;
			interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 86 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 87 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_pio>;
			gpio-controller;
			interrupt-controller;
			#interrupt-cells = <3>;
			#size-cells = <0>;
			#gpio-cells = <3>;
		};

		dump_reg: dump_reg@20000 {
			compatible = "allwinner,sunxi-dump-reg";
			reg = <0x0 0x00020000 0x0 0x0004>;
		};

		uart0: uart@05000000 {
			compatible = "allwinner,sun8i-uart";
			device_type = "uart0";
			reg = <0x0 0x05000000 0x0 0x400>;
			interrupts = <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_uart0>;
			uart0_port = <0>;
			uart0_type = <2>;
			status = "okay";
		};

		uart1: uart@5000400 {
			compatible = "allwinner,sun8i-uart";
			device_type = "uart1";
			reg = <0x0 0x05000400 0x0 0x400>;
			interrupts = <GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_uart1>;
			sunxi,uart-fifosize = <256>;
			uart1_port = <1>;
			uart1_type = <4>;
			status = "disabled";
		};

		uart2: uart@5000800 {
			compatible = "allwinner,sun8i-uart";
			device_type = "uart2";
			reg = <0x0 0x05000800 0x0 0x400>;
			interrupts = <GIC_SPI 62 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_uart2>;
			sunxi,uart-fifosize = <256>;
			uart2_port = <2>;
			uart2_type = <4>;
			status = "disabled";
		};

		uart3: uart@5000c00 {
			compatible = "allwinner,sun8i-uart";
			device_type = "uart3";
			reg = <0x0 0x05000c00 0x0 0x400>;
			interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_uart3>;
			sunxi,uart-fifosize = <256>;
			uart3_port = <3>;
			uart3_type = <4>;
			status = "disabled";
		};

		uart4: uart@5001000 {
			compatible = "allwinner,sun8i-uart";
			device_type = "uart4";
			reg = <0x0 0x05001000 0x0 0x400>;
			interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_uart4>;
			sunxi,uart-fifosize = <256>;
			uart4_port = <4>;
			uart4_type = <4>;
			status = "disabled";
		};

		uart5: uart@7080000 {
			compatible = "allwinner,sun8i-uart";
			device_type = "uart5";
			reg = <0x0 0x07080000 0x0 0x400>;
			interrupts = <GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_cpuruart0>;
			sunxi,uart-fifosize = <256>;
			uart5_port = <5>;
			uart5_type = <2>;
			status = "disabled";
		};

		uart6: uart@70800400 {
			compatible = "allwinner,sun8i-uart";
			device_type = "uart6";
			reg = <0x0 0x07080400 0x0 0x400>;
			interrupts = <GIC_SPI 142 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_cpuruart1>;
			sunxi,uart-fifosize = <256>;
			uart6_port = <6>;
			uart6_type = <4>;
			status = "disabled";
		};

		uart7: uart@7080800 {
			compatible = "allwinner,sun8i-uart";
			device_type = "uart7";
			reg = <0x0 0x07080800 0x0 0x400>;
			interrupts = <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_cpuruart2>;
			sunxi,uart-fifosize = <256>;
			uart7_port = <7>;
			uart7_type = <4>;
			status = "disabled";
		};

		uart8: uart@70800c00 {
			compatible = "allwinner,sun8i-uart";
			device_type = "uart8";
			reg = <0x0 0x07080c00 0x0 0x400>;
			interrupts = <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_cpuruart3>;
			sunxi,uart-fifosize = <256>;
			uart8_port = <8>;
			uart8_type = <4>;
			status = "disabled";
		};

		uart9: uart@7081000 {
			compatible = "allwinner,sun8i-uart";
			device_type = "uart9";
			reg = <0x0 0x07081000 0x0 0x400>;
			interrupts = <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_cpuruart4>;
			sunxi,uart-fifosize = <256>;
			uart9_port = <9>;
			uart9_type = <4>;
			status = "disabled";
		};

		dma0: dma-controller@3002000 {
			compatible = "allwinner,dma-v110";
			reg = <0x0 0x3002000 0x0 0x1000>;
			interrupts = <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_dma>;
			clock-names = "bus";
			dma-channels = <12>;
			dma-requests = <64>;
			#dma-cells = <1>;
		};

		twi0: twi@5002000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sun8i-twi";
			device_type = "twi0";
			reg = <0x0 0x05002000 0x0 0x400>;
			interrupts = <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_twi0>;
			twi_drv_used = <0>; /* only support eng mode for this platform */
			status = "disabled";
		};

		twi1: twi@5002400 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sun8i-twi";
			device_type = "twi1";
			reg = <0x0 0x05002400 0x0 0x400>;
			interrupts = <GIC_SPI 47 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_twi1>;
			twi_drv_used = <0>; /* only support eng mode for this platform */
			status = "disabled";
		};

		twi2: twi@5002800 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sun8i-twi";
			device_type = "twi2";
			reg = <0x0 0x05002800 0x0 0x400>;
			interrupts = <GIC_SPI 48 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_twi2>;
			twi_drv_used = <0>; /* only support eng mode for this platform */
			status = "disabled";
		};

		twi3: twi@5002c00 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sun8i-twi";
			device_type = "twi3";
			reg = <0x0 0x05002c00 0x0 0x400>;
			interrupts = <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_twi3>;
			twi_drv_used = <0>; /* only support eng mode for this platform */
			status = "disabled";
		};

		twi4: twi@5003000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sun8i-twi";
			device_type = "twi4";
			reg = <0x0 0x05003000 0x0 0x400>;
			interrupts = <GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_twi4>;
			twi_drv_used = <0>; /* only support eng mode for this platform */
			status = "disabled";
		};

		twi5: twi@5003400 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sun8i-twi";
			device_type = "twi5";
			reg = <0x0 0x05003400 0x0 0x400>;
			interrupts = <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_twi5>;
			twi_drv_used = <0>; /* only support eng mode for this platform */
			status = "disabled";
		};

		twi6: twi@5003800 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sun8i-twi";
			device_type = "twi6";
			reg = <0x0 0x05003800 0x0 0x400>;
			interrupts = <GIC_SPI 119 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_twi6>;
			twi_drv_used = <0>; /* only support eng mode for this platform */
			status = "disabled";
		};

