			interrupts = <GIC_SPI 137 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_pwm>;
			pwm-number = <8>;
			pwm-base = <0x9>;
			sunxi-pwms = <&s_pwm0>, <&s_pwm1>, <&s_pwm2>, <&s_pwm3>, <&s_pwm4>, <&s_pwm5>, <&s_pwm6>, <&s_pwm7>;
		};

		s_pwm0: s_pwm@7020c10 {
			compatible = "allwinner,sunxi-pwm8";
			reg = <0x0 0x07020c10 0x0 0x4>;
			reg_base = <0x07020c00>;
			status = "disabled";
		};

		s_pwm1: s_pwm@7020c11 {
			compatible = "allwinner,sunxi-pwm9";
			reg = <0x0 0x07020c11 0x0 0x4>;
			reg_base = <0x07020c00>;
			status = "disabled";
		};

		s_pwm2: s_pwm@7020c12 {
			compatible = "allwinner,sunxi-pwm10";
			reg = <0x0 0x07020c12 0x0 0x4>;
			reg_base = <0x07020c00>;
			status = "disabled";
		};

		s_pwm3: s_pwm@7020c13 {
			compatible = "allwinner,sunxi-pwm11";
			reg = <0x0 0x07020c13 0x0 0x4>;
			reg_base = <0x07020c00>;
			status = "disabled";
		};

		s_pwm4: s_pwm@7020c14 {
			compatible = "allwinner,sunxi-pwm12";
			reg = <0x0 0x07020c14 0x0 0x4>;
			reg_base = <0x07020c00>;
			status = "disabled";
		};

		s_pwm5: s_pwm@7020c15 {
			compatible = "allwinner,sunxi-pwm13";
			reg = <0x0 0x07020c15 0x0 0x4>;
			reg_base = <0x07020c00>;
			status = "disabled";
		};

		s_pwm6: s_pwm@7020c16 {
			compatible = "allwinner,sunxi-pwm14";
			reg = <0x0 0x07020c16 0x0 0x4>;
			reg_base = <0x07020c00>;
			status = "disabled";
		};

		s_pwm7: pwm7@7020c17 {
			compatible = "allwinner,sunxi-pwm15";
			reg = <0x0 0x07020c17 0x0 0x4>;
			reg_base = <0x07020c00>;
			status = "disabled";
		};

		gpadc0: gpadc@5070000 {
			compatible = "allwinner,sunxi-gpadc-v105";
			reg = <0x0 0x05070000 0x0 0x400>;
			interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_gpadc>;
			status = "disabled";
		};

		lradc: lradc@7030800 {
			compatible = "allwinner,keyboard_2000mv";
			reg = <0x0 0x07030800 0x0 0x400>;
			interrupts = <GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_cpurlradc>;
			status = "disabled";
		};

		/* audio dirver module -> I2S/PCM */
		i2s0_plat:i2s0_plat@2032000 {
			#sound-dai-cells = <0>;
			compatible = "allwinner,sun8iw17-i2s";
			reg		= <0x0 0x05090000 0x0 0x74>;
			resets		= <&ccu RST_I2S_PCM_0>;
			clocks		= <&clk_pll_audio>, <&clk_i2s0>;
			clock-names	= "clk_pll_audio", "clk_i2s";
			dmas		= <&dma0 3>, <&dma0 3>;
			dma-names	= "tx", "rx";
			playback-cma	= <128>;
			capture-cma	= <128>;
			tx-fifo-size	= <128>;
			rx-fifo-size	= <128>;
			status = "disabled";
		};

		i2s0_mach:i2s0_mach{
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name		= "sndi2s0";
			soundcard-mach,format		= "i2s";
			soundcard-mach,slot-num		= <2>;
			soundcard-mach,slot-width	= <32>;
			status = "disabled";
			soundcard-mach,cpu {
				sound-dai = <&i2s0_plat>;
			};
			soundcard-mach,codec {
			};
		};

		i2s1_plat:i2s1_plat@2033000 {
			#sound-dai-cells = <0>;
