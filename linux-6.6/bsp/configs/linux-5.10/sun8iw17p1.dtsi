		mdio0: mdio0@5020048 {
			compatible = "allwinner,sunxi-mdio";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0 0x05020048 0x0 0x8>;
			status = "disabled";
			gmac0_phy0: ethernet-phy@1 {
				reg = <1>;
				max-speed = <100>;  /* Max speed capability */
				/* PHY datasheet rst time */
				reset-assert-us = <10000>;
				reset-deassert-us = <150000>;
			};
		};

