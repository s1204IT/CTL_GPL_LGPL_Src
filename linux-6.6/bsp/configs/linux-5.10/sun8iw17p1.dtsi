			interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "gmacirq";
			clocks = <&clk_gmac>;
			clock-names = "gmac";
			phy-handle = <&gmac0_phy0>;
			status = "disabled";
		};

