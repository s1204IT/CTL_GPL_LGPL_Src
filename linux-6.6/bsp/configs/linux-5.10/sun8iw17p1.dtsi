		i2s2_plat:i2s2_plat@2034000 {
			#sound-dai-cells = <0>;
			compatible = "allwinner,sun8iw17-i2s";
			reg		= <0x0 0x05092000 0x0 0x74>;
			resets		= <&ccu RST_I2S_PCM_2>;
			clocks		= <&clk_pll_audio>, <&clk_i2s2>;
			clock-names	= "clk_pll_audio", "clk_i2s";
			dmas		= <&dma0 5>, <&dma0 5>;
			dma-names	= "tx", "rx";
			playback-cma	= <128>;
			capture-cma	= <128>;
			tx-fifo-size	= <128>;
			rx-fifo-size	= <128>;
			status = "disabled";
		};

		i2s2_mach:i2s2_mach{
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name		= "sndi2s2";
			soundcard-mach,format		= "i2s";
